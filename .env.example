# ─── Flatmate configuration ──────────────────────────────────────────────────
# Copy this file to .env and fill in the values. The app reads .env at startup;
# no build flags are needed.
#
#   cp .env.example .env
#   flutter run
#
# .env is git-ignored. .env.example is committed as the template.

# REQUIRED. The Supabase publishable ("anon") key for the project below.
# It is a public client key — take it from the web app's .env, or from the
# Supabase dashboard under Project Settings -> API.
SUPABASE_ANON_KEY=

# The Supabase project that issues the JWTs the API verifies.
SUPABASE_URL=https://nlpvkgtyrlbybobxzhex.supabase.co

# Root of the REST API. /health lives here; everything else is under /api/v1.
API_SERVER_ROOT=https://www.zygonich.com/livemate

# ─── Optional tuning ─────────────────────────────────────────────────────────
# Leave these out entirely to use the defaults shown.

# Network timeouts, in seconds.
CONNECT_TIMEOUT_SECONDS=20
RECEIVE_TIMEOUT_SECONDS=30

# Server-enforced limits, mirrored client-side so a user finds out before a
# round trip rather than after one. Change these only if the API changes.
MAX_PHOTOS_PER_LISTING=4
MIN_PHOTOS_TO_PUBLISH=3
MAX_PHOTO_MB=2
MAX_SEARCH_RESULTS=50
MAX_TAGS_PER_FINDER_POST=5
